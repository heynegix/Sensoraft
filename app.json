{
  "expo": {
    "name": "Sensoraft",
    "slug": "sensoraft",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sensoraft.app",
