{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sensoraft-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
  },
  "ratelimits": [
    {
      "name": "AI_CLIENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      "name": "AI_GLOBAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": ["GEMINI_API_KEY"],
  },
}
